{
  "name": "@forge-fr/monorepo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/forge-fr/forgejs.git"
  },
  "scripts": {
    "build": "tsc -b --force packages/*/tsconfig.json",
    "typecheck": "tsc -b packages/*/tsconfig.json --noEmit",
    "packages:build": "node scripts/prepare-github-packages.mjs --build",
    "packages:validate": "node scripts/verify-workspace.mjs",
    "packages:verify": "node scripts/verify-packaging.mjs",
    "packages:publish:npm": "node scripts/prepare-github-packages.mjs --build --publish --registry https://registry.npmjs.org",
    "packages:prepare:github": "node scripts/prepare-github-packages.mjs --build --verify --pack --out-dir dist-packages",
    "packages:publish:github": "node scripts/prepare-github-packages.mjs --build --publish --registry https://npm.pkg.github.com",
    "docs:verify": "node scripts/verify-docs-examples.mjs",
    "bench": "node benchmarks/run-all.mjs"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "@opentelemetry/api": "^1.10.0",
    "@standard-schema/spec": "^1.1.0",
    "drizzle-orm": "^0.45.4",
    "jose": "^6.2.18",
    "pino": "^10.4.0",
    "postgres": "^4.1.1",
    "valibot": "^1.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@hono/node-server": "^2.1.11",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.0",
    "fast-check": "^4.11.0",
    "fastify": "^5.12.8",
    "hono": "^4.13.22",
    "tinybench": "^6.2.5",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.2"
  }
}
