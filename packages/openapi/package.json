{
  "name": "@forge-fr/openapi",
  "version": "1.0.0-rc.2",
  "description": "Zero-dependency OpenAPI 3.1 generator, Zod v4 / Valibot v1 / Standard Schema JSON Schema reflection, Swagger UI endpoint with strict CSP/HTML escaping, and ForgeJS plugin.",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "engines": {
    "node": ">=22.18.0"
  },
  "keywords": [
    "forgejs",
    "openapi",
    "openapi-3.1",
    "swagger",
    "json-schema",
    "standard-schema",
    "zod",
    "valibot",
    "typescript",
    "bun",
    "nodejs"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dependencies": {
    "@forge-fr/core": "^1.0.0-rc.2",
    "@forge-fr/http": "^1.0.0-rc.2",
    "@forge-fr/validation": "^1.0.0-rc.2"
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/forge-fr/forgejs.git",
    "directory": "packages/openapi"
  },
  "homepage": "https://github.com/forge-fr/forgejs#readme",
  "bugs": {
    "url": "https://github.com/forge-fr/forgejs/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
