{
  "name": "@forge-fr/node",
  "version": "1.0.0-rc.2",
  "description": "Native Node.js (node:http) runtime adapter for ForgeJS with backpressure-safe Web Streams, client abort propagation, body size enforcement, and graceful connection draining.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.18.0"
  },
  "keywords": [
    "forgejs",
    "nodejs",
    "http",
    "adapter",
    "web-standards",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/forge-fr/forgejs.git",
    "directory": "packages/node"
  },
  "homepage": "https://github.com/forge-fr/forgejs#readme",
  "bugs": {
    "url": "https://github.com/forge-fr/forgejs/issues"
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@forge-fr/http": "^1.0.0-rc.2"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
