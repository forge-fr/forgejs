{
  "name": "@forge-fr/testing",
  "version": "1.0.0-rc.1",
  "description": "In-memory HTTP runtime adapter, ergonomic test client, and DI provider override helpers for testing ForgeJS applications on Node.js and Bun.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.18.0"
  },
  "keywords": [
    "forgejs",
    "testing",
    "http",
    "memory-adapter",
    "typescript",
    "bun",
    "nodejs"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/forge-fr/forgejs.git",
    "directory": "packages/testing"
  },
  "homepage": "https://github.com/forge-fr/forgejs#readme",
  "bugs": {
    "url": "https://github.com/forge-fr/forgejs/issues"
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@forge-fr/core": "^1.0.0-rc.1",
    "@forge-fr/http": "^1.0.0-rc.1"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
