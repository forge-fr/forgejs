{
  "name": "@forge-fr/edge",
  "version": "1.0.0",
  "description": "WinterCG Edge runtime adapter and deployment handlers for ForgeJS (Cloudflare Workers, Deno, Vercel Edge, and standard Fetch runtimes).",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.18.0"
  },
  "keywords": [
    "forgejs",
    "edge",
    "cloudflare-workers",
    "deno",
    "wintercg",
    "fetch",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/forge-fr/forgejs.git",
    "directory": "packages/edge"
  },
  "homepage": "https://github.com/forge-fr/forgejs#readme",
  "bugs": {
    "url": "https://github.com/forge-fr/forgejs/issues"
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@forge-fr/http": "^1.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
