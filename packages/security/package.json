{
  "name": "@forge-fr/security",
  "version": "1.0.0-rc.2",
  "description": "OWASP ASVS 5.0.0 backend security suite for ForgeJS: hardened headers, strict CORS, CSRF protection, rate limiting, prototype pollution & path traversal defenses, hardened cookies, and SSRF-safe fetch guard.",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "engines": {
    "node": ">=22.18.0"
  },
  "keywords": [
    "forgejs",
    "security",
    "owasp",
    "asvs",
    "cors",
    "csrf",
    "rate-limit",
    "ssrf",
    "headers",
    "typescript",
    "bun",
    "nodejs"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dependencies": {
    "@forge-fr/core": "^1.0.0-rc.2",
    "@forge-fr/http": "^1.0.0-rc.2"
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/forge-fr/forgejs.git",
    "directory": "packages/security"
  },
  "homepage": "https://github.com/forge-fr/forgejs#readme",
  "bugs": {
    "url": "https://github.com/forge-fr/forgejs/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
