{
  "name": "@forge-fr/cli",
  "version": "1.0.0-rc.1",
  "description": "Official cross-runtime ForgeJS CLI: project scaffolding (new), dev/build/start/test orchestration, module/controller/service code generators, plugin management, and environment diagnostics (doctor).",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "engines": {
    "node": ">=22.18.0"
  },
  "keywords": [
    "forgejs",
    "cli",
    "scaffolding",
    "generator",
    "devtools",
    "typescript",
    "bun",
    "nodejs"
  ],
  "bin": {
    "forge": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dependencies": {
    "@forge-fr/core": "^1.0.0-rc.1"
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/forge-fr/forgejs.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/forge-fr/forgejs#readme",
  "bugs": {
    "url": "https://github.com/forge-fr/forgejs/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
