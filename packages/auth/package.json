{
  "name": "@forge-fr/auth",
  "version": "1.0.0-rc.1",
  "description": "Modular authentication suite for ForgeJS: Argon2id password hashing, hardened sessions, JWT/JWKS via jose, hashed API keys, OAuth 2.0/OIDC PKCE primitives, and Better Auth adapter.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.18.0"
  },
  "keywords": [
    "forgejs",
    "auth",
    "authentication",
    "argon2id",
    "jwt",
    "jose",
    "oauth2",
    "oidc",
    "sessions",
    "better-auth",
    "typescript",
    "bun",
    "nodejs"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/forge-fr/forgejs.git",
    "directory": "packages/auth"
  },
  "homepage": "https://github.com/forge-fr/forgejs#readme",
  "bugs": {
    "url": "https://github.com/forge-fr/forgejs/issues"
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@forge-fr/core": "^1.0.0-rc.1",
    "@forge-fr/http": "^1.0.0-rc.1",
    "@node-rs/argon2": "^2.2.0",
    "jose": "^6.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
