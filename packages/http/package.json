{
  "name": "@forge-fr/http",
  "version": "1.0.0",
  "description": "Web Standards HTTP engine for ForgeJS with ForgeContext, deterministic tiered middleware, bounded body/multipart parsers, content negotiation, SSE/streaming, and request-scoped DI.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./realtime": {
      "types": "./dist/realtime.d.ts",
      "import": "./dist/realtime.js",
      "default": "./dist/realtime.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.18.0"
  },
  "keywords": [
    "forgejs",
    "http",
    "web-standards",
    "middleware",
    "sse",
    "typescript",
    "bun",
    "nodejs"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/forge-fr/forgejs.git",
    "directory": "packages/http"
  },
  "homepage": "https://github.com/forge-fr/forgejs#readme",
  "bugs": {
    "url": "https://github.com/forge-fr/forgejs/issues"
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@forge-fr/core": "^1.0.0",
    "@forge-fr/router": "^1.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
