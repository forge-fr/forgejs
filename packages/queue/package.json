{
  "name": "@forge-fr/queue",
  "version": "1.0.0",
  "description": "Background job queue contract, exponential retry & backoff policies, idempotency keys, dead-letter queue, per-job timeouts, graceful worker draining, and ForgeJS plugin.",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "engines": {
    "node": ">=22.18.0"
  },
  "keywords": [
    "forgejs",
    "queue",
    "jobs",
    "worker",
    "background-jobs",
    "retry",
    "dlq",
    "typescript",
    "bun",
    "nodejs"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dependencies": {
    "@forge-fr/core": "^1.0.0"
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/forge-fr/forgejs.git",
    "directory": "packages/queue"
  },
  "homepage": "https://github.com/forge-fr/forgejs#readme",
  "bugs": {
    "url": "https://github.com/forge-fr/forgejs/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
